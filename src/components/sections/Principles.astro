---
import Panel from '../ui/Panel.astro';
import Poster from '../ui/Poster.astro';
import Icon from '../ui/Icon.astro';
import { getUI, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const t = getUI(lang);
---

<Panel id="filosofia" title={t.principles} note={t.principlesNote}>
  <div class="principles__grid">
    {t.principlesList.map((item, i) => (
      <article class="principles__card">
        <span class="principles__icon">
          <Icon name={i === 0 ? 'code' : 'spark'} size={30} />
        </span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="principles__tag">{item.tag}</span>
        </div>
        <span class="principles__quote" aria-hidden="true">
          ”
        </span>
      </article>
    ))}
    <Poster variant="principles" explorer={t.explorer} lines={t.principlesPoster} compact />
  </div>
</Panel>
<style lang="scss">
  @use '../../styles/geometry';
  .principles {
    &__grid {
      display: grid;
      grid-template-columns: 1fr 1fr 0.45fr;
      gap: 0.9375rem;
    }
    &__card {
      @include geometry.cut-surface(var(--shape-card));

      padding: 1.125rem;
      display: flex;
      gap: 1.0625rem;
      position: relative;
      --cut-surface: var(--surface-gradient);
      h3 {
        font: 700 0.9375rem/1.3 var(--font-body);
        max-width: 15.625rem;
        color: var(--white);
        margin: 0 0 0.5rem;
      }
      p {
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--text);
        margin: 0 0 1.125rem;
        max-width: 18.75rem;
      }
    }
    &__icon {
      @include geometry.cut-surface(var(--shape-control));
      color: var(--signal);
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 0;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    &__tag {
      color: var(--muted);
      font: 0.5rem var(--font-mono);
    }
    &__quote {
      position: absolute;
      bottom: 0.3125rem;
      right: 0.8125rem;
      color: var(--signal);
      font: 900 2.75rem/1 var(--font-display);
    }
    @media (max-width: 760px) {
      &__grid {
        grid-template-columns: 1fr;
        :global(.poster) {
          display: none;
        }
      }
      &__card {
        padding: 0.9375rem;
        h3 {
          font-size: 0.875rem;
        }
        p {
          font-size: 0.6875rem;
          max-width: none;
        }
      }
      &__icon {
        width: 2.6875rem;
        height: 2.6875rem;
      }
    }
  }
</style>
