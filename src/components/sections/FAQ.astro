---
import Panel from '../ui/Panel.astro';
import Poster from '../ui/Poster.astro';
import { getUI, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
  items?: { question: string; answer: string }[];
  title?: string;
  note?: string;
  explorer?: string;
}

const { lang, items, title, note, explorer } = Astro.props;

const t = getUI(lang);

const questions = items ?? t.faqList;
---

<Panel id="preguntas" title={title ?? t.faq} note={note ?? t.faqNote} class="faq-panel">
  <div class="faq-layout">
    <Poster
      variant="questions"
      compact
      explorer={explorer ?? t.eyebrow}
      lines={
        lang === 'es'
          ? ['ANTES', 'DE DAR', 'EL PRÓXIMO', 'PASO.']
          : ['BEFORE', 'YOUR', 'NEXT', 'STEP.']
      }
    />
    <div class="faq">
      {questions.map(({ question, answer }, index) => (
        <details class="faq__item" data-accordion>
          <summary>
            <span class="faq__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{question}</span>
            <span class="faq__toggle" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="faq__answer" data-accordion-content>
            <p>{answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</Panel>

<style lang="scss">
  @use '../../styles/geometry';
  :global(section.panel.faq-panel) {
    padding: clamp(1.125rem, 2.5vw, 2.25rem);
  }
  :global(section.panel.faq-panel > .panel__header) {
    margin-bottom: 1.5rem;
    align-items: flex-start;
  }
  :global(section.panel.faq-panel .panel__title) {
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.035em;
  }
  :global(section.panel.faq-panel .panel__note) {
    flex-shrink: 0;
    padding-top: 0.25rem;
  }
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    gap: 1.5rem;
    align-items: stretch;
    :global(.poster) {
      min-height: 22rem;
    }
    :global(.poster strong) {
      font-size: clamp(1rem, 2vw, 1.75rem);
      left: 1.25rem;
      top: 1.5rem;
    }
  }
  .faq {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    &__item {
      @include geometry.cut-surface(var(--shape-control));
      --cut-surface: var(--black);
      --cut-line: var(--line);
      &[open] {
        --cut-line: var(--signal);
        --cut-surface: var(--surface-gradient);
      }
    }
    summary {
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr) 1.75rem;
      gap: 0.75rem;
      align-items: center;
      list-style: none;
      cursor: pointer;
      padding: 1.25rem;
      min-height: 5rem;
      font-size: 1rem;
      color: var(--white);
      line-height: 1.6;
      &::-webkit-details-marker {
        display: none;
      }
      &:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -4px;
      }
    }
    &__index {
      font: 0.625rem/1.5 var(--font-mono);
      color: var(--signal);
    }
    &__toggle {
      display: grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      background: var(--surface-tint);
      color: var(--signal);
      font-size: 1.5rem;
      line-height: 1;
      clip-path: var(--shape-compact);
      transition: transform 0.2s;
    }
    &__item[open] summary {
      color: var(--accent);
    }
    &__item[open] .faq__toggle {
      transform: rotate(45deg);
    }
    &__answer {
      display: flow-root;
      padding: 0 1.25rem 1.25rem 3.75rem;
      p {
        font-size: 0.9375rem;
        line-height: 1.8;
        max-width: 80ch;
        margin: 0;
        color: var(--text);
      }
    }
    &__item[data-accordion-state='revealing'] .faq__answer {
      will-change: clip-path;
    }
  }
  @media (max-width: 760px) {
    :global(section.panel.faq-panel > .panel__header) {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    :global(section.panel.faq-panel .panel__title) {
      font-size: 0.9375rem;
    }
    :global(section.panel.faq-panel .panel__note) {
      text-align: left;
      max-width: none;
    }
    .faq-layout {
      grid-template-columns: minmax(0, 1fr);
      :global(.poster) {
        display: none;
      }
    }
    .faq summary {
      grid-template-columns: 1.25rem minmax(0, 1fr) 1.5rem;
      gap: 0.5rem;
      padding: 1rem;
    }
    .faq__toggle {
      width: 1.5rem;
      height: 1.5rem;
    }
    .faq__answer {
      padding: 0 1rem 1rem;
    }
  }
</style>
