---
import Panel from '../ui/Panel.astro';
import ProcessCard from '../ui/ProcessCard.astro';
import { getUI, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const t = getUI(lang);
---

<Panel id="proceso" title={t.process} note={t.processNote}>
  <ol class="process__grid">
    {t.processList.map((step, i) => (
      <ProcessCard {...step} index={i} />
    ))}
  </ol>
</Panel>
<style lang="scss">
  .process__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    @media (max-width: 1000px) {
      gap: 0.75rem;
    }
    @media (max-width: 760px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
