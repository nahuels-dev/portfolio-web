---
import Panel from '../ui/Panel.astro';
import type { Project } from '../../data/projects';
import { projectUI } from '../../i18n/projects';
import type { Locale } from '../../i18n/ui';

interface Props {
  project: Project;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = projectUI[lang];
const copy = project.copy[lang];
---

<Panel id="contexto" title={t.overview} note={t.context} class="project-section">
  <div class="project-context">
    <p class="project-context__overview">{copy.overview}</p>
    <div class="project-context__columns">
      <div>
        <h3>
          <span>01 /</span>
          {t.challenge}
        </h3>
        <p>{copy.challenge}</p>
      </div>
      <div>
        <h3>
          <span>02 /</span>
          {t.solution}
        </h3>
        <p>{copy.solution}</p>
      </div>
    </div>
  </div>
</Panel>
