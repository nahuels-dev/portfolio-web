---
import type { Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  path: string;
  alternatePath: string;
  schema: object;
  image?: string;
  imageAlt?: string;
}

const { lang, title, description, path, alternatePath, schema, image, imageAlt } = Astro.props;

const canonical = new URL(path, Astro.site);

const esPath = lang === 'es' ? path : alternatePath;

const enPath = lang === 'en' ? path : alternatePath;

const socialImage = new URL(image ?? '/images/og-cover.jpg', Astro.site);
const imageType = {
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  png: 'image/png',
  webp: 'image/webp',
}[socialImage.pathname.split('.').at(-1)?.toLowerCase() ?? ''];

const socialImageAlt =
  imageAlt ??
  (lang === 'es'
    ? 'Portfolio de Nahuel Silva, desarrollador web en Uruguay'
    : 'Portfolio of Nahuel Silva, web developer in Uruguay');
---

<meta name="theme-color" content="#101220" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content="Nahuel Silva" />
<meta name="color-scheme" content="dark" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
<link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nahuel Silva" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'es' ? 'es_UY' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_UY'} />
<meta property="og:image" content={socialImage} />
{imageType && <meta property="og:image:type" content={imageType} />}
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
