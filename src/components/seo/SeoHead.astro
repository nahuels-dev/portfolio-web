---
import { createHash } from 'node:crypto';
import type { Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  path: string;
  alternatePath: string;
  schema: object;
  image?: string;
  imageAlt?: string;
  blog?: boolean;
  noindex?: boolean;
  published?: string;
  modified?: string;
}

const {
  lang,
  title,
  description,
  path,
  alternatePath,
  schema,
  image,
  imageAlt,
  blog,
  noindex,
  published,
  modified,
} = Astro.props;
const structuredData = JSON.stringify(schema).replace(/</g, '\\u003c');
const hash = createHash('sha256').update(structuredData).digest('base64');
const contactOrigin = new URL(
  import.meta.env.PUBLIC_CONTACT_ENDPOINT || 'https://mail.sora.agency/api/v1/contact',
  Astro.site,
).origin;
const policy = [
  "default-src 'self'",
  "base-uri 'none'",
  "object-src 'none'",
  "frame-src 'none'",
  "form-action 'self'",
  `script-src 'self' 'sha256-${hash}' https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms https://static.cloudflareinsights.com`,
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data: blob: https://*.clarity.ms https://c.bing.com https://www.googletagmanager.com",
  `connect-src 'self' ${contactOrigin} https://*.clarity.ms https://www.googletagmanager.com https://cloudflareinsights.com`,
  'upgrade-insecure-requests',
].join('; ');

const canonical = new URL(path, Astro.site);

const esPath = lang === 'es' ? path : alternatePath;

const enPath = lang === 'en' ? path : alternatePath;

const socialImage = new URL(image ?? '/images/og-cover.jpg', Astro.site);
const imageType = {
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  png: 'image/png',
  webp: 'image/webp',
}[socialImage.pathname.split('.').at(-1)?.toLowerCase() ?? ''];

const socialImageAlt =
  imageAlt ??
  (lang === 'es'
    ? 'Portfolio de Nahuel Silva, desarrollador web en Uruguay'
    : 'Portfolio of Nahuel Silva, web developer in Uruguay');
---

{blog && import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
{blog && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`Blog — Nahuel Silva (${lang})`}
    href={lang === 'es' ? '/blog/rss.xml' : '/en/blog/rss.xml'}
  />
)}
<meta name="theme-color" content="#101220" />
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>
<meta name="author" content="Nahuel Silva" />
<meta name="color-scheme" content="dark" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
<link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />
<meta property="og:type" content={published ? 'article' : 'website'} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
<meta property="og:site_name" content="Nahuel Silva" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'es' ? 'es_UY' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_UY'} />
<meta property="og:image" content={socialImage} />
{imageType && <meta property="og:image:type" content={imageType} />}
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
<script type="application/ld+json" set:html={structuredData} />
