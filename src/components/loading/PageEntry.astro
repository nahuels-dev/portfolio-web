---
import { BOOT_TIMING } from '../../scripts/loading/boot-timing';
import SpeculationRules from './SpeculationRules.astro';
---

<style is:inline>
  :root {
    --page-transition-duration: 720ms;
  }
  @view-transition {
    navigation: auto;
  }
  html[data-page-entry='pending']::view-transition-old(root) {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>

<SpeculationRules />

<script is:inline define:vars={{ bootDeadline: BOOT_TIMING.deadline }}>
  (() => {
    const key = 'portfolio:next-page';
    const requestEntry = () => {
      if (document.documentElement.dataset.pageTransition) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      window.__pageEntryPending = true;
      if (!document.prerendering) {
        document.documentElement.dataset.pageEntry = 'pending';
        clearTimeout(window.__pageEntryDeadline);
        window.__pageEntryDeadline = setTimeout(() => {
          window.__pageEntryPending = false;
          delete document.documentElement.dataset.pageEntry;
          window.__pageSnapshotFrame?.remove();
          delete window.__pageSnapshotFrame;
        }, bootDeadline);
      }
    };
    const pageURL = (value) => {
      const url = new URL(value, location.href);
      return `${url.origin}${url.pathname.replace(/\/$/, '')}${url.search}`;
    };
    const readEntry = () => {
      try {
        const next = JSON.parse(sessionStorage.getItem(key) || 'null');
        sessionStorage.removeItem(key);
        const matches =
          next?.url === pageURL(location.href) &&
          Date.now() - next.time >= 0 &&
          Date.now() - next.time < 15000;
        if (
          matches &&
          next.snapshot?.html &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          window.__pageSnapshotFrame?.remove();
          const frame = document.createElement('iframe');
          frame.dataset.pageSnapshot = '';
          frame.title = '';
          frame.setAttribute('aria-hidden', 'true');
          frame.setAttribute('sandbox', 'allow-same-origin');
          frame.inert = true;
          frame.style.cssText = `position:fixed;inset:0;width:${next.snapshot.width}px;height:${next.snapshot.height}px;border:0;pointer-events:none;visibility:hidden;z-index:2147483646`;
          frame.addEventListener(
            'load',
            () => {
              frame.style.visibility = 'visible';
            },
            { once: true },
          );
          frame.srcdoc = next.snapshot.html;
          document.documentElement.append(frame);
          window.__pageSnapshotFrame = frame;
        }
        return matches;
      } catch {}
      return false;
    };
    const navigationType = performance.getEntriesByType('navigation')[0]?.type;
    let internal = !document.prerendering && navigationType !== 'reload' && readEntry();
    if (navigationType === 'reload') {
      try {
        sessionStorage.removeItem(key);
      } catch {}
    }
    if (navigationType === 'reload') internal = false;
    if (navigationType === 'back_forward') internal = true;

    const remember = (href) => {
      try {
        const url = new URL(href, location.href);
        if (url.origin === location.origin) {
          const entry = { url: pageURL(url), time: Date.now() };
          try {
            sessionStorage.setItem(
              key,
              JSON.stringify({ ...entry, snapshot: window.__capturePageSnapshot?.() }),
            );
          } catch {
            sessionStorage.setItem(key, JSON.stringify(entry));
          }
        }
      } catch {}
    };
    const handleSkippedTransition = (transition) => {
      if (!transition) return;
      void transition.ready.catch(() => {});
      void transition.updateCallbackDone.catch(() => {});
      void transition.finished.catch(() => {});
    };

    let destination;
    document.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
      if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self'))
        return;
      destination = link.href;
    });

    if ('onpageswap' in window) {
      window.addEventListener('pageswap', (event) => {
        handleSkippedTransition(event.viewTransition);
        const url = event.activation?.entry.url ?? destination;
        if (url && (event.viewTransition || (destination && pageURL(destination) === pageURL(url))))
          remember(url);
        destination = undefined;
      });
    } else {
      window.addEventListener('pagehide', () => {
        if (destination) remember(destination);
        destination = undefined;
      });
    }

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      readEntry();
      requestEntry();
    });
    document.addEventListener(
      'prerenderingchange',
      () => {
        readEntry();
        requestEntry();
      },
      { once: true },
    );

    const reveal = () => {
      clearTimeout(window.__bootDeadline);
      window.dispatchEvent(new Event('portfolio:boot-timeout'));
      delete document.documentElement.dataset.boot;
      const screen = document.querySelector('[data-loading-screen]');
      if (screen) screen.hidden = true;
      document.querySelectorAll('[data-boot-content]').forEach((el) => (el.inert = false));
    };
    window.addEventListener('pagereveal', (event) => {
      if (!event.viewTransition) return;
      reveal();
      requestEntry();
      window.__pageViewTransition = event.viewTransition;
      if (window.__pageSnapshotFrame) window.__pageSnapshotFrame.hidden = true;
      handleSkippedTransition(event.viewTransition);
      void event.viewTransition.finished
        .finally(() => {
          if (window.__pageViewTransition === event.viewTransition)
            delete window.__pageViewTransition;
        })
        .catch(() => {});
    });

    try {
      const skip = new URLSearchParams(location.search).get('intro') === '0';
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const prerendered =
        document.prerendering || performance.getEntriesByType('navigation')[0]?.activationStart > 0;
      if (internal || prerendered) requestEntry();
      if (!internal && !prerendered && !skip && !reduced && !navigator.connection?.saveData) {
        window.__bootStartedAt = performance.now();
        document.documentElement.dataset.boot = 'pending';
        window.__bootDeadline = setTimeout(reveal, bootDeadline);
      }
    } catch {}
  })();
</script>

<script>
  import { initPageTransition } from '../../scripts/effects/page-transition';
  const disposeTransition = initPageTransition();
  if (import.meta.hot) import.meta.hot.dispose(disposeTransition);
</script>
