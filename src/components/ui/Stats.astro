---
import Icon from './Icon.astro';
import type { Locale } from '../../i18n/ui';
import { getUI } from '../../i18n/ui';

interface Props {
  lang: Locale;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;

const t = getUI(lang);

const rows = compact
  ? [
      ['03', `${t.statLabel[0]} ${t.statLabel[1]}`],
      ['∞', `${t.statLabel[2]} ${t.statLabel[3]}`],
    ]
  : t.aboutStats;
---

<div class:list={['stats', { 'stats--compact': compact }]}>
  {rows.map((row, i) => (
    <div class="stats__row">
      <span class="stats__icon">
        <Icon name={['layers', 'bars', 'download'][i]} size={23} />
      </span>
      <div>
        <strong class="stats__value">
          {row[0] === '∞' ? (
            <Icon name="infinity" label={lang === 'es' ? 'Sin límite' : 'Unlimited'} />
          ) : (
            row[0]
          )}
        </strong>
        <span class="stats__label">{row[1]}</span>
      </div>
    </div>
  ))}
</div>
<style lang="scss">
  @use '../../styles/geometry';
  .stats {
    @include geometry.cut-surface(var(--shape-card));
    min-width: 0;

    padding: 0.4375rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 0;
    &__row {
      display: flex;
      gap: 0.875rem;
      align-items: center;
      padding: 1rem 0;
      & + & {
        border-top: 0.0625rem solid var(--line-bright);
      }
    }
    &__icon {
      @include geometry.cut-surface(var(--shape-compact));
      width: 2.375rem;
      height: 2.375rem;
      --cut-surface: var(--surface-tint);
      color: var(--signal);

      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    &__value {
      font: 900 clamp(1.0625rem, 2vw, 1.5625rem)/1 var(--font-display);
      display: block;
      letter-spacing: -0.04em;
      color: var(--accent);
      :global(svg) {
        display: block;
        width: 1.3em;
        height: 1em;
      }
    }
    &__label {
      font-size: 0.625rem;
      line-height: 1.3;
      letter-spacing: 0.04em;
      display: block;
      margin-top: 0.3125rem;
      max-width: 7.5rem;
    }
    &--compact {
      --cut-surface: var(--surface-gradient);
      color: var(--white);

      padding: 0 0.9375rem;
      .stats__row {
        padding: 0.9375rem 0;
        & + .stats__row {
          border-color: color-mix(in srgb, var(--brand) 22%, transparent);
        }
      }
      .stats__icon {
        --cut-surface: var(--surface-tint);
        color: var(--signal);
      }
      .stats__value {
        font-size: 1.8125rem;
      }
      .stats__label {
        font-size: 0.5625rem;
        max-width: 6.25rem;
      }
    }
    @media (max-width: 600px) {
      padding: 0.25rem 0.625rem;
      &__icon {
        width: 1.75rem;
        height: 1.75rem;
        svg {
          width: 1.1875rem;
        }
      }
      &__row {
        gap: 0.5rem;
        padding: 0.75rem 0;
      }
      &__value {
        font-size: 1rem;
      }
      &__label {
        font-size: 0.5rem;
      }
      &--compact {
        padding: 0 0.5625rem;
        .stats__row {
          padding: 0.625rem 0;
        }
        .stats__value {
          font-size: 1.4375rem;
        }
        .stats__label {
          font-size: 0.5rem;
        }
      }
    }
    @media (max-width: 760px) {
      &--compact {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        padding: 0.875rem;
        .stats__row {
          min-width: 0;
          gap: 0.5rem;
          padding: 0;
          > div {
            min-width: 0;
          }
          & + .stats__row {
            border-top: 0;
            border-left: 0.0625rem solid var(--line);
            padding-left: 0.75rem;
          }
        }
        .stats__icon {
          width: 1.5rem;
          height: 1.5rem;
        }
        .stats__icon :global(svg) {
          width: 1.0625rem;
          height: 1.0625rem;
        }
        .stats__value {
          font-size: 1.625rem;
        }
        .stats__label {
          font-size: 0.625rem;
          max-width: none;
        }
      }
    }
  }
</style>
