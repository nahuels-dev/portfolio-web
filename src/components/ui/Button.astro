---
import Icon from './Icon.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  href?: string;
  contact?: boolean;
  as?: 'a' | 'button';
  glitch?: boolean;
  variant?: 'primary' | 'secondary' | 'ghost' | 'text' | 'icon';
  icon?: string | false;
  external?: boolean;
  class?: string;
  download?: boolean;
}

const {
  href,
  contact = false,
  as: Element = 'a',
  glitch = true,
  variant = 'secondary',
  icon = 'arrow',
  external = false,
  class: className,
  download = false,
  type = 'button',
  ...attributes
} = Astro.props;
---

<Element
  {...attributes}
  href={Element === 'a' ? href : undefined}
  type={Element === 'button' ? type : undefined}
  class:list={['button', `button--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download || undefined}
  data-glitch={glitch || undefined}
  data-contact-open={contact || undefined}
  aria-haspopup={contact ? 'dialog' : attributes['aria-haspopup']}
  aria-controls={contact ? 'contact-dialog' : attributes['aria-controls']}
>
  <span class="button__label">
    <slot />
  </span>
  {icon && <Icon name={icon} size={20} />}
</Element>
<style lang="scss">
  .button {
    --button-border: var(--signal);
    --button-surface: var(--black);
    --button-ink: var(--signal);
    --button-shape: var(--shape-control);
    display: inline-flex;
    position: relative;
    isolation: isolate;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 2.8125rem;
    padding: 0.625rem 1.125rem;
    border: 0.0625rem solid transparent;
    border-radius: 0;
    clip-path: var(--button-shape);
    color: var(--button-ink);
    background: var(--button-border);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
    &::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 0;
      clip-path: var(--button-shape);
      background: var(--button-surface);
      transition: background 0.2s;
    }
    &--primary {
      --button-border: var(--accent);
      --button-surface: var(--accent);
      --button-ink: var(--black);
      --button-shape: polygon(
        0.5625rem 0,
        calc(100% - 0.625rem) 0,
        100% 0.625rem,
        100% calc(100% - 0.625rem),
        calc(100% - 0.625rem) 100%,
        0.25rem 100%,
        0 calc(100% - 0.3125rem),
        0 0.5625rem
      );
      &:hover:not(:disabled) {
        --button-border: var(--accent-hover);
        --button-surface: var(--accent-hover);
      }
    }
    &--secondary:hover:not(:disabled),
    &--icon:hover:not(:disabled) {
      --button-surface: var(--surface-hover);
      --button-ink: var(--signal-hover);
      --button-border: var(--signal-hover);
    }
    &--ghost {
      --button-border: #5e586b;
      --button-surface: var(--surface);
      --button-ink: var(--white);
      --button-shape: var(--shape-compact);
      padding: 0.375rem 0.75rem;
      min-height: 2rem;
      font-size: 0.6875rem;
      &:hover:not(:disabled) {
        --button-border: var(--accent);
        --button-ink: var(--accent);
      }
    }
    &:focus-visible {
      outline: none;
      background: var(--white);
      .button__label {
        text-decoration: underline;
        text-underline-offset: 0.25rem;
      }
    }
    &--icon {
      justify-content: center;
      width: 2.8125rem;
      height: 2.8125rem;
      padding: 0.5rem;
      gap: 0;
    }
    &--text {
      --button-border: transparent;
      --button-surface: transparent;
      min-height: 2rem;
      padding: 0.25rem 0;
      border: 0;
      clip-path: none;
      gap: 0.4375rem;
      font-size: 0.6875rem;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: none;
      &:hover:not(:disabled) {
        --button-ink: var(--signal-hover);
      }
      &:focus-visible {
        background: transparent;
        outline: 0.125rem solid var(--accent);
        outline-offset: 0.25rem;
      }
      :global(svg) {
        width: 1rem;
        height: 1rem;
      }
    }
    &:disabled {
      --button-border: var(--line);
      --button-surface: var(--surface);
      --button-ink: var(--muted);
      cursor: not-allowed;
    }
    &[hidden] {
      display: none;
    }
    &__label {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    :global(svg) {
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    &:hover :global(svg) {
      transform: translate(0.125rem, -0.125rem);
    }
  }
</style>
