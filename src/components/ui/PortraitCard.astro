---
import { Picture } from 'astro:assets';
import { aboutPortrait } from '../../data/portrait-image';

interface Props {
  words: string[];
}

const { words } = Astro.props;
---

<div class="portrait-card" aria-hidden="true">
  <div class="portrait-card__frame">
    <div class="portrait-card__image">
      <Picture
        {...aboutPortrait}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        sizes="(max-width: 600px) calc(100vw - 56px), (max-width: 900px) 38vw, 40vw"
        loading="lazy"
      />
    </div>
    <div class="portrait-card__words">
      {words.map((word) => (
        <span>{word}</span>
      ))}
      <i>///</i>
    </div>
    <span class="portrait-card__crosses">
      +<br />+<br />+
    </span>
    <span class="portrait-card__calibration">
      <span />+<b>╂</b>
    </span>
  </div>
  <span class="portrait-card__hazard" />
  <span class="portrait-card__matrix" />
  <svg class="portrait-card__chevron" width="44" height="66" viewBox="0 0 44 66" fill="none">
    <path d="M40 3 10 33l30 30" stroke="currentColor" stroke-width="1.5" />
  </svg>
</div>

<style lang="scss">
  .portrait-card {
    --portrait-shape: polygon(
      0 10%,
      32% 10%,
      41% 0,
      79% 0,
      100% 20%,
      100% 42%,
      79% 64%,
      100% 85%,
      100% 96%,
      96% 100%,
      3% 100%,
      0 97%
    );
    position: relative;
    min-height: 24.375rem;
    isolation: isolate;
    &__frame {
      position: absolute;
      inset: 0;
      background: var(--line-bright);
      clip-path: var(--portrait-shape);
    }
    &__image {
      --portrait-position: 35% 0%;
      overflow: hidden;
      position: absolute;
      inset: 0.0625rem;
      clip-path: var(--portrait-shape);
      background: linear-gradient(125deg, #dfd2ff, #a98bff);
      :global(picture),
      :global(img) {
        display: block;
        width: 100%;
        height: 100%;
      }
      :global(img) {
        object-fit: cover;
        object-position: var(--portrait-position);
      }
    }
    &__words {
      position: absolute;
      left: 1.5625rem;
      bottom: 1.3125rem;
      color: var(--white);
      font: 700 1.0625rem/1.05 var(--font-body);
      letter-spacing: 0.07em;
      text-shadow: 0 0.0625rem 0.5rem #000;
      padding: 0.375rem 0.5rem 0.3125rem;
      background: color-mix(in srgb, var(--black) 80%, transparent);
      border-left: 0.0625rem solid var(--signal);
      span {
        display: block;
      }
      i {
        display: block;
        margin-top: 0.6875rem;
        color: var(--signal);
        font: italic 900 1.9375rem/1 var(--font-display);
        letter-spacing: 0.125rem;
      }
    }
    &__crosses {
      position: absolute;
      left: 1.0625rem;
      top: 15%;
      color: var(--black);
      font: 0.9375rem/2.3 var(--font-mono);
    }
    &__hazard {
      position: absolute;
      right: 2.375rem;
      top: 0.5rem;
      width: 2.1875rem;
      height: 1.0625rem;
      background: repeating-linear-gradient(
        45deg,
        var(--signal) 0 0.125rem,
        transparent 0.125rem 0.3125rem
      );
    }
    &__matrix {
      position: absolute;
      right: 0.375rem;
      top: 0.5rem;
      width: 1.5rem;
      height: 1.5rem;
      background: radial-gradient(circle, var(--muted) 0.0625rem, transparent 0.09375rem) 0 0 /
        0.3125rem 0.3125rem;
      opacity: 0.7;
    }
    &__chevron {
      position: absolute;
      color: var(--signal);
      right: 2%;
      top: 58%;
      width: 11%;
      height: 16%;
    }
    &__calibration {
      position: absolute;
      right: 7%;
      bottom: 1.4375rem;
      display: flex;
      align-items: center;
      gap: 0.625rem;
      color: var(--black);
      font: 0.625rem var(--font-mono);
      span {
        width: 2.625rem;
        height: 0.0625rem;
        background: currentColor;
        opacity: 0.45;
      }
      b {
        font-size: 1.6875rem;
        line-height: 1;
        font-weight: 400;
      }
    }
    @media (max-width: 900px) {
      min-height: 22.5rem;
    }
    @media (max-width: 600px) {
      min-height: 0;
      aspect-ratio: 1.12;
      &__words {
        font-size: 0.9375rem;
        left: 1.25rem;
        bottom: 1.125rem;
      }
      &__crosses {
        font-size: 0.75rem;
      }
      &__calibration {
        bottom: 1.1875rem;
      }
    }
  }
</style>
