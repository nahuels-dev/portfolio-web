---
import Icon from './Icon.astro';
import MediaImage from './MediaImage.astro';
import Tag from './Tag.astro';
import type { Locale } from '../../i18n/ui';
import { projectPath, type Project } from '../../data/projects';

interface Props {
  project: Project;
  lang: Locale;
}

const { project: p, lang } = Astro.props;
---

<a data-glitch class="project-card" href={projectPath(p, lang)}>
  <div class="project-card__content">
    <div class="project-card__eyebrow">
      <span>
        {p.id} / {p.category[lang]}
      </span>
      <Icon size={17} />
    </div>
    <h3>{p.name}</h3>
    <p>{p.description[lang]}</p>
  </div>
  <div class="project-card__image">
    <MediaImage
      src={p.image}
      widths={[320, 480, 720]}
      sizes="(max-width: 700px) 42vw, 30vw"
      alt={lang === 'es' ? `Captura del proyecto ${p.name}` : `Screenshot of ${p.name}`}
      loading="lazy"
    />
    <span class="project-card__image-label">{p.label}</span>
    <span class="project-card__arrow">
      <Icon size={19} />
    </span>
  </div>
  <div class="project-card__tags">
    {p.tech.map((tech) => (
      <Tag small>{tech}</Tag>
    ))}
  </div>
</a>
<style lang="scss">
  @use '../../styles/geometry';
  .project-card {
    @include geometry.cut-surface(var(--shape-card));
    display: flex;
    flex-direction: column;
    padding: 0.8125rem;

    text-decoration: none;
    color: var(--text);
    --cut-surface: var(--surface-gradient);
    transition:
      border-color 0.2s,
      background 0.2s;
    min-width: 0;
    &:hover {
      --cut-line: var(--signal);
      --cut-surface: var(--surface-hover);
      .project-card__image :global(img) {
        transform: scale(1.045);
        filter: saturate(0.95);
      }
      .project-card__arrow {
        --cut-surface: var(--accent);
        --cut-line: var(--accent);
        color: var(--black);
      }
    }
    &__eyebrow {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
      font: 0.5rem var(--font-mono);
      text-transform: uppercase;
    }
    h3 {
      font-size: 1.0625rem;
      font-weight: 500;
      line-height: 1.2;
      color: var(--white);
      margin: 0.5rem 0 0.375rem;
      text-transform: uppercase;
    }
    p {
      font-size: 0.75rem;
      line-height: 1.45;
      max-width: 18.125rem;
      margin: 0 0 0.8125rem;
      min-height: 2.1875rem;
    }
    &__image {
      position: relative;
      aspect-ratio: 1.95;
      overflow: hidden;
      border: 0.0625rem solid #ffffff1c;
      clip-path: var(--shape-control);
      background: var(--surface);
      :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
        transition:
          transform 0.45s,
          filter 0.45s;
        filter: saturate(0.65);
      }
      &::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent 60%, #000d);
        pointer-events: none;
      }
    }
    &__image-label {
      position: absolute;
      z-index: 1;
      bottom: 0.625rem;
      left: 0.625rem;
      font: 0.5rem var(--font-mono);
      color: #fff;
    }
    &__arrow {
      @include geometry.cut-surface(var(--shape-compact));
      position: absolute;
      z-index: 1;
      right: 0.5rem;
      bottom: 0.4375rem;
      display: grid;
      place-items: center;
      width: 1.8125rem;
      height: 1.8125rem;
      --cut-surface: var(--black);
      color: var(--accent);
      transition: background 0.2s;
    }
    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      padding-top: 0.6875rem;
    }
    @media (max-width: 700px) {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      column-gap: 0.75rem;
      padding: 0.625rem;
      &__content {
        grid-column: 1;
        grid-row: 1;
      }
      &__eyebrow {
        font-size: 0.4375rem;
        svg {
          display: none;
        }
      }
      h3 {
        font-size: 0.875rem;
        margin: 0.3125rem 0;
      }
      p {
        font-size: 0.6875rem;
        min-height: 0;
        margin-bottom: 0.5rem;
      }
      &__image {
        grid-column: 2;
        grid-row: 1/3;
        aspect-ratio: auto;
        min-height: 7.1875rem;
      }
      &__image-label {
        font-size: 0.375rem;
        left: 0.375rem;
        bottom: 0.375rem;
      }
      &__tags {
        grid-column: 1;
        padding: 0;
        align-self: end;
        gap: 0.25rem;
        :global(.tag) {
          font-size: 0.4375rem;
          padding: 0.25rem 0.375rem;
        }
      }
    }
  }
</style>
