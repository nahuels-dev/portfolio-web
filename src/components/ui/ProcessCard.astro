---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  text: string;
  index: number;
  detailed?: boolean;
}

const { icon, title, text, index, detailed = false } = Astro.props;
---

<li class:list={['process-card', { 'process-card--detailed': detailed }]}>
  <span class="process-card__icon">
    <Icon name={icon} size={30} />
  </span>
  <div class="process-card__content">
    <span class="process-card__number">0{index + 1}</span>
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
  <span class="process-card__corner" aria-hidden="true" />
</li>
<style lang="scss">
  @use '../../styles/geometry';
  .process-card {
    @include geometry.cut-surface(var(--shape-card));
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    min-height: 8.75rem;
    padding: 1.1875rem 1.0625rem;
    --cut-surface: var(--surface-gradient);
    &__icon {
      background: var(--accent);
      color: var(--black);
      clip-path: var(--shape-control);
      width: 2.9375rem;
      height: 2.9375rem;
      border-radius: 0;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      box-shadow: 0 0 0.75rem color-mix(in srgb, var(--accent) 7%, transparent);
    }
    &__number {
      font: 700 1.1875rem/1 var(--font-display);
      color: var(--signal);
    }
    h3 {
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      color: var(--white);
      margin: 0.1875rem 0 0.4375rem;
    }
    p {
      font-size: 0.6875rem;
      line-height: 1.5;
      color: var(--text);
      margin: 0;
    }
    &__corner {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 3.4375rem;
      height: 1.4375rem;
      background: repeating-linear-gradient(
        -45deg,
        transparent 0 0.5rem,
        color-mix(in srgb, var(--brand) 15%, transparent) 0.5rem 0.9375rem
      );
    }
    @media (max-width: 600px) {
      padding: 0.875rem 0.75rem;
      gap: 0.625rem;
      min-height: 9.75rem;
      &__icon {
        width: 2.125rem;
        height: 2.125rem;
        svg {
          width: 1.4375rem;
        }
      }
      &__number {
        font-size: 1rem;
      }
      h3 {
        font-size: 0.6875rem;
      }
      p {
        font-size: 0.625rem;
      }
    }
  }
  .process-card--detailed {
    min-width: 0;
    min-height: 13rem;
    padding: 1.25rem;
    flex-direction: column;
    gap: 1.25rem;
    .process-card__content {
      min-width: 0;
    }
    .process-card__number {
      font-size: 1.5rem;
    }
    h3 {
      font-size: 1rem;
      line-height: 1.4;
      margin: 0.5rem 0 0.75rem;
      font-weight: 700;
    }
    p {
      font-size: 0.9375rem;
      line-height: 1.75;
    }
    @media (max-width: 760px) {
      flex-direction: row;
      gap: 1rem;
      min-height: 0;
      .process-card__icon {
        width: 2.5rem;
        height: 2.5rem;
      }
    }
  }
</style>
