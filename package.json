{
  "name": "nahuel-s-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "format": "prettier --write src astro.config.mjs tsconfig.json package.json .prettierrc.json public/admin/config.yml .github wrangler.jsonc",
    "format:check": "prettier --check src astro.config.mjs tsconfig.json package.json .prettierrc.json public/admin/config.yml .github wrangler.jsonc",
    "cms": "BIND_HOST=127.0.0.1 MODE=fs decap-server",
    "deploy": "npm run build && wrangler deploy --no-autoconfig"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tabler/icons-astro": "3.50.0",
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sass": "1.106.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74",
    "decap-server": "3.11.6",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
